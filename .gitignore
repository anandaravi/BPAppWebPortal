# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# YouTube OAuth secrets
youtube_auth.json
scripts/client_secrets.json
scripts/.youtube_token.pkl
scripts/__pycache__/

# Local screenshots
*.png
!public/**/*.png

# Tool directories
.claude/
.playwright-cli/

# Windows Zone.Identifier files
*:Zone.Identifier

# Abandoned Pollinations page-images script
scripts/generate-page-images.py
